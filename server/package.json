{
  "name": "audio-watch-clicker-server",
  "version": "2.0.0",
  "private": true,
  "description": "Recebe eventos dos clickers e repassa para os dispositivos de cada usuário via SSE",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --env-file=.env --disable-warning=ExperimentalWarning --watch server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  }
}
