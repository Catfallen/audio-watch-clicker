# Copie para .env e preencha.

# Segredo para assinar os JWT (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres

PORT=3000

# "false" impede novos cadastros (deixe "true" só até criar as contas que precisa)
REGISTRO_ABERTO=true

# Atrás do nginx, use 1 para o limite de tentativas enxergar o IP real do cliente
# TRUST_PROXY=1

# Caminho do banco SQLite (padrão: server/dados.db)
# DB_PATH=/var/lib/audio-watch-clicker/dados.db
